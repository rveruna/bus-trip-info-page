    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.1",
    "jest-environment-jsdom": "^30.0.1",
    "jsdom": "^26.1.0",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
